{
  "deny": [
    "sudo",
    "doas",
    "su",
    "curl",
    "wget",
    "mkfs",
    "dd",
    "dd if=",
    "chmod 777",
    "chmod -R 777",
    "chown -R root",
    "git push --force",
    "git push -f",
    "git reset --hard",
    "git clean -f",
    "shutdown",
    "reboot",
    "halt",
    "poweroff",
    "diskutil"
  ],
  "allow": []
}
